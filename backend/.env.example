# ========================
# JWT Configuration
# ========================

# Secret key for signing JWT tokens (CHANGE IN PRODUCTION!)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production-12345

# JWT Algorithm for token signing
JWT_ALGORITHM=HS256

# Access token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token expiration (days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Bcrypt rounds for password hashing (higher = more secure but slower)
BCRYPT_ROUNDS=12


# ========================
# Database Configuration
# ========================

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://admin:admin123@postgres:5432/storage_db

# Alternative for local development:
# DATABASE_URL=postgresql+psycopg://admin:admin123@localhost:5433/storage_db


# ========================
# CORS Configuration
# ========================

# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ========================
# Hadoop HDFS Configuration
# ========================

# HDFS WebHDFS URL
HDFS_URL=http://namenode:9870

# Path to the storage data CSV file in HDFS
HDFS_FILE_PATH=/data/storage/storage_data.csv

# HDFS user
HDFS_USER=root


# ========================
# Application Configuration
# ========================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Environment (development, staging, production)
ENVIRONMENT=development

# Enable reload for development
DEBUG=True
