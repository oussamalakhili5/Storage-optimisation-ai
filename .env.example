# Database Configuration
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=storage_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5433
DATABASE_URL=postgresql+psycopg://admin:your_secure_password_here@postgres:5432/storage_db

# Flask Configuration
FLASK_SECRET_KEY=your_64_character_flask_secret_key_here
FLASK_ENV=development
FLASK_DEBUG=True

# JWT Configuration
JWT_SECRET_KEY=your_64_character_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRES=3600

# HDFS Configuration
HDFS_NAMENODE_HOST=namenode
HDFS_NAMENODE_PORT=9870
HDFS_NAMENODE_RPC_PORT=9000
HDFS_USER=root
HDFS_FILE_PATH=/data/storage/storage_data.csv
HADOOP_CLUSTER_NAME=storage-hadoop-cluster

# CORS & Ports
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_PORT=8000
FRONTEND_PORT=5173
